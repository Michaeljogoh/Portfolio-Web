# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/portfolio?schema=public"

# JWT (min 32 characters)
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# Seeded admin (used by `pnpm db:seed`)
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="change-this-strong-password"

# Contact form (Postmark — https://postmarkapp.com)
POSTMARK_SERVER_TOKEN="your-server-api-token"
CONTACT_TO_EMAIL="michaeljogoh@gmail.com"
# Must match a verified Sender Signature in Postmark
CONTACT_FROM_EMAIL="contact@yourdomain.com"
# Optional — defaults to "outbound"
# POSTMARK_MESSAGE_STREAM="outbound"

# Optional
# NEXT_PUBLIC_SITE_URL=http://localhost:3002
